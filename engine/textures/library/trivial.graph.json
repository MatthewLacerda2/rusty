{
  "resolution": 256,
  "params": { "wear": { "type": "number", "default": 0.3, "min": 0, "max": 1 } },
  "nodes": [
    { "id": "h0", "op": "noise", "kind": "fbm", "scale": 4, "octaves": 4 },
    { "id": "h", "op": "auto_levels", "inputs": ["h0"] },
    { "id": "w", "op": "constant", "color": [1, 1, 1, 1] },
    { "id": "hw", "op": "expression", "expr": "a * (0.5 + 0.5 * k1)", "k1": { "param": "wear" }, "inputs": ["h"] },
    { "id": "base", "op": "color_ramp", "inputs": ["hw"], "stops": [ { "pos": 0, "color": "#404040" }, { "pos": 1, "color": "#b0b0b0" } ] },
    { "id": "n", "op": "bump_to_normal", "strength": 1, "inputs": ["hw"] },
    { "id": "r", "op": "map_range", "from_min": 0, "from_max": 1, "to_min": 0.4, "to_max": 0.9, "inputs": ["h"] }
  ],
  "output": "base",
  "outputs": { "base_color": "base", "normal": "n", "roughness": "r", "height": "h", "occlusion": "w" }
}
