// engine/shaders/postfx/grade.wgsl — where an HDR colour sits in the grading LUT
// (#1440).
//
// The bake (generated by `render::postfx::effects::assemble::bake_source`) runs the
// grading effects' functions (`postfx/effects/*.wgsl`) once per texel of a 32³
// table whenever a grading knob or the tonemap changes; the composite then grades
// every pixel with one tetrahedral read of it (`lut_sample`). The table is indexed
// by a log encoding (`encode`), so its 32 steps per channel span HDR from 0 to about 50, densest in the darks
// where the eye needs them. Unity URP and Unreal build their HDR grading LUT the
// same way.

#define_import_path postfx::grade

// Texels per side of the LUT. Mirrors `GradeLut::SIZE`.
const LUT_SIZE: f32 = 32.0;

// The table's log encoding: t = log2(1 + 64x) / LOG_SPAN, a LogC-shaped curve
// (linear-ish in the darks, logarithmic above) whose span is chosen so black
// (t = 0) and display white (t = 16/31) fall exactly on texels. Unity's LogC puts
// neither on one, and interpolating across a texel there lifts black by a level and
// pulls an untonemapped 1.0 down by seven. The table reaches x ≈ 50.8 (t = 1);
// brighter colour reads the top texel.
const LOG_SCALE: f32 = 64.0;
// log2(1 + 64) · 31 / 16: places x = 1 on texel 16 of 0..31.
const LOG_SPAN: f32 = 11.668338;

fn encode(x: vec3<f32>) -> vec3<f32> {
    return log2(1.0 + LOG_SCALE * max(x, vec3<f32>(0.0))) / LOG_SPAN;
}

fn decode(t: vec3<f32>) -> vec3<f32> {
    return (exp2(t * LOG_SPAN) - 1.0) / LOG_SCALE;
}

// The graded colour of HDR colour `c`: the LUT read at its log code by tetrahedral
// interpolation (#1701), four texel loads in the one of six tetrahedra of the cell
// that holds `c`. Every tetrahedron has the cell's grey diagonal as an edge, so a
// grey reads only grey texels: a tonemapper that couples the channels (Neutral
// offsets by the smallest and scales by the largest) stays exact and monotone on
// greys, where trilinear blends off-grey corners in and bent a grey ramp by up to
// eight levels. A curve applied per channel reads the same as trilinear gives.
// DaVinci Resolve and OCIO interpolate 3D LUTs this way.
fn lut_sample(lut: texture_3d<f32>, c: vec3<f32>) -> vec3<f32> {
    let p = clamp(encode(c), vec3<f32>(0.0), vec3<f32>(1.0)) * (LUT_SIZE - 1.0);
    let base = min(floor(p), vec3<f32>(LUT_SIZE - 2.0));
    let f = p - base;
    // The cell's axes in the order f falls (a first, then b), and f in that order.
    var a = vec3<i32>(1, 0, 0);
    var b = vec3<i32>(0, 1, 0);
    var w = f;
    if (f.x >= f.y) {
        if (f.y >= f.z) {
            w = f.xyz;
        } else if (f.x >= f.z) {
            b = vec3<i32>(0, 0, 1);
            w = f.xzy;
        } else {
            a = vec3<i32>(0, 0, 1);
            b = vec3<i32>(1, 0, 0);
            w = f.zxy;
        }
    } else if (f.z >= f.y) {
        a = vec3<i32>(0, 0, 1);
        w = f.zyx;
    } else if (f.z >= f.x) {
        a = vec3<i32>(0, 1, 0);
        b = vec3<i32>(0, 0, 1);
        w = f.yzx;
    } else {
        a = vec3<i32>(0, 1, 0);
        b = vec3<i32>(1, 0, 0);
        w = f.yxz;
    }
    let i = vec3<i32>(base);
    let c0 = textureLoad(lut, i, 0).rgb;
    let c1 = textureLoad(lut, i + a, 0).rgb;
    let c2 = textureLoad(lut, i + a + b, 0).rgb;
    let c3 = textureLoad(lut, i + vec3<i32>(1), 0).rgb;
    return (1.0 - w.x) * c0 + (w.x - w.y) * c1 + (w.y - w.z) * c2 + w.z * c3;
}

// Rec. 709 luminance. Mirrors `core::color::luminance`, the weights Unity uses.
fn luminance(c: vec3<f32>) -> f32 {
    return dot(c, vec3<f32>(0.2126, 0.7152, 0.0722));
}
