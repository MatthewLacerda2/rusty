#!/bin/sh
# rusty's push hook (#1096). Activate once per clone with `make setup`.
# `git rebase --continue` runs no pre-commit hook, so a conflict resolved by hand
# is committed unchecked; this re-runs rustfmt over every crate the pushed branch
# touches against origin/main (tools/lint included), with no build — about a second.
# Git passes the pushed refs on stdin. `git push --no-verify` skips it; CI does not.
exec python3 .github/scripts/resolved.py --hook
