# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# IDEs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
Thumbs.db
ehthumbs.db
.DS_Store

#Project Specifics
auxmd.md
# Provider keys (#383): yours, never committed. `.env.example` names the variables.
.env
# A developer's local game project: what every binary opens when no `--project`
# is given (#829). Games live in their own folders and repos, never in this one.
/project/

# The test-fixture project (#829): only its committed fixtures are tracked, never
# what the engine seeds into it when it is opened.
/tests/fixtures/project/*
!/tests/fixtures/project/scenarios/
!/tests/fixtures/project/project.rusty
!/tests/fixtures/project/assets/
/tests/fixtures/project/assets/*
!/tests/fixtures/project/assets/scripts/
/tests/fixtures/project/assets/scripts/*
!/tests/fixtures/project/assets/scripts/bot_player.lua

# In-process tests run with the checkout as their working directory, so what they
# seed or bake (project-relative paths) lands here. The engine's own content is
# engine/, so nothing tracked lives under these.
/assets/
/.seeded

# Lint reports
.lint/

# cargo-mutants output (transient local mutation-testing run; CI uploads it as an artifact)
mutants.out/
mutants.out*.tmp/

# Background-agent git worktrees (transient; auto-cleaned)
.claude/worktrees/

# Harness run artifacts
out/

# cargo-mutants run output
/mutants.out/
/mutants.out.old/

# Python bytecode from the merge helpers in .github/scripts (#486)
__pycache__/

# Headless editor captures (#731): attached to PRs, never committed.
/editor-capture*.png
