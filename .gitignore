# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# IDEs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
Thumbs.db
ehthumbs.db
.DS_Store

#Project Specifics
auxmd.md
# Ignore the local project tree, but keep the committed sample scenarios and the
# example bot-player scripts (the harness's fixtures). The parent must be re-included
# before the children.
/project/*
!/project/scenarios/
/project/scenarios/*
!/project/scenarios/*.lua
!/project/scripts/
/project/scripts/*
!/project/scripts/*.lua

# Lint reports
.lint/

# cargo-mutants output (transient local mutation-testing run; CI uploads it as an artifact)
mutants.out/
mutants.out*.tmp/

# Background-agent git worktrees (transient; auto-cleaned)
.claude/worktrees/

# Harness run artifacts
out/
