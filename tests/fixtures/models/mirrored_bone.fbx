; FBX 7.4.0 project file
; One bone mirrored by scale (#1110), a one-metre cube skinned to it so the
; import yields a skin. Hand-written, so every number is deliberate: Z up, like
; skinned_cube.fbx, with Lcl Scaling (1,-1,1) and a 30° turn about Z, so the
; change of basis permutes the negative scale onto another axis. One stack,
; "Turn": over one second the bone climbs from 100 to 200 cm and turns from 30°
; to 90° about Z; ufbx bakes the scale keys at rest. So key 0 is the rest pose,
; and the last key differs from it in everything but the scale.
FBXHeaderExtension:  {
	FBXHeaderVersion: 1003
	FBXVersion: 7400
	Creator: "rusty test fixture"
}
GlobalSettings:  {
	Version: 1000
	Properties70:  {
		P: "UpAxis", "int", "Integer", "",2
		P: "UpAxisSign", "int", "Integer", "",1
		P: "FrontAxis", "int", "Integer", "",1
		P: "FrontAxisSign", "int", "Integer", "",-1
		P: "CoordAxis", "int", "Integer", "",0
		P: "CoordAxisSign", "int", "Integer", "",1
		P: "UnitScaleFactor", "double", "Number", "",1
	}
}
Objects:  {
	Geometry: 1000, "Geometry::Cube", "Mesh" {
		Vertices: *24 {
			a: -50,-50,-50,50,-50,-50,50,50,-50,-50,50,-50,-50,-50,50,50,-50,50,50,50,50,-50,50,50
		}
		PolygonVertexIndex: *24 {
			a: 0,3,2,-2,4,5,6,-8,0,1,5,-5,2,3,7,-7,3,0,4,-8,1,2,6,-6
		}
		GeometryVersion: 124
	}
	Model: 2000, "Model::Cube", "Mesh" {
		Version: 232
	}
	Model: 3000, "Model::Bone", "LimbNode" {
		Version: 232
		Properties70:  {
			P: "Lcl Translation", "Lcl Translation", "", "A",0,0,100
			P: "Lcl Rotation", "Lcl Rotation", "", "A",0,0,30
			P: "Lcl Scaling", "Lcl Scaling", "", "A",1,-1,1
		}
	}
	NodeAttribute: 3100, "NodeAttribute::Bone", "LimbNode" {
		TypeFlags: "Skeleton"
	}
	Deformer: 5000, "Deformer::Skin", "Skin" {
		Version: 101
		Link_DeformAcuracy: 50
	}
	Deformer: 5100, "SubDeformer::Bone", "Cluster" {
		Version: 100
		Indexes: *8 {
			a: 0,1,2,3,4,5,6,7
		}
		Weights: *8 {
			a: 1,1,1,1,1,1,1,1
		}
		Transform: *16 {
			a: 0.8660254,0.5,0,0,0.5,-0.8660254,0,0,0,0,1,0,0,0,-100,1
		}
		TransformLink: *16 {
			a: 0.8660254,0.5,0,0,0.5,-0.8660254,0,0,0,0,1,0,0,0,100,1
		}
	}
	AnimationStack: 6000, "AnimStack::Turn", "" {
		Properties70:  {
			P: "LocalStart", "KTime", "Time", "",0
			P: "LocalStop", "KTime", "Time", "",46186158000
		}
	}
	AnimationLayer: 6100, "AnimLayer::BaseLayer", "" {
	}
	AnimationCurveNode: 6200, "AnimCurveNode::T", "" {
		Properties70:  {
			P: "d|X", "Number", "", "A",0
			P: "d|Y", "Number", "", "A",0
			P: "d|Z", "Number", "", "A",100
		}
	}
	AnimationCurve: 6300, "AnimCurve::", "" {
		Default: 100
		KeyVer: 4009
		KeyTime: *2 {
			a: 0,46186158000
		}
		KeyValueFloat: *2 {
			a: 100,200
		}
		KeyAttrFlags: *1 {
			a: 4
		}
		KeyAttrDataFloat: *4 {
			a: 0,0,0,0
		}
		KeyAttrRefCount: *1 {
			a: 2
		}
	}
	AnimationCurveNode: 6400, "AnimCurveNode::R", "" {
		Properties70:  {
			P: "d|X", "Number", "", "A",0
			P: "d|Y", "Number", "", "A",0
			P: "d|Z", "Number", "", "A",30
		}
	}
	AnimationCurve: 6500, "AnimCurve::", "" {
		Default: 30
		KeyVer: 4009
		KeyTime: *2 {
			a: 0,46186158000
		}
		KeyValueFloat: *2 {
			a: 30,90
		}
		KeyAttrFlags: *1 {
			a: 4
		}
		KeyAttrDataFloat: *4 {
			a: 0,0,0,0
		}
		KeyAttrRefCount: *1 {
			a: 2
		}
	}
}
