; FBX 7.4.0 project file
; One triangle whose material's texture is neither on disk nor embedded, so the
; converter skips it (#1197) and its colour stays, without its factor (#1293).
; Hand-written.
FBXHeaderExtension:  {
	FBXHeaderVersion: 1003
	FBXVersion: 7400
	Creator: "rusty test fixture"
}
Objects:  {
	Geometry: 1000, "Geometry::Tri", "Mesh" {
		Vertices: *9 {
			a: 0,0,0,1,0,0,0,1,0
		}
		PolygonVertexIndex: *3 {
			a: 0,1,-3
		}
		GeometryVersion: 124
	}
	Model: 2000, "Model::Tri", "Mesh" {
		Version: 232
	}
	Material: 3000, "Material::Gone", "" {
		Version: 102
		ShadingModel: "lambert"
		Properties70:  {
			P: "DiffuseColor", "Color", "", "A",0.2,0.4,0.6
			P: "DiffuseFactor", "Number", "", "A",0.5
		}
	}
	Texture: 4100, "Texture::Gone", "" {
		Type: "TextureVideoClip"
		Version: 202
		TextureName: "Texture::Gone"
		FileName: "/missing/gone.png"
		RelativeFilename: "gone.png"
	}
}
Connections:  {
	C: "OO",2000,0
	C: "OO",1000,2000
	C: "OO",3000,2000
	C: "OP",4100,3000, "DiffuseColor"
}
