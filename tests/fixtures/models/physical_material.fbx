; FBX 7.4.0 project file
; One triangle whose material is a 3ds Max Physical Material (by its class ids), so
; its colour is weighted by `base_weight`, never read by the classic rules (#1293).
; Hand-written.
FBXHeaderExtension:  {
	FBXHeaderVersion: 1003
	FBXVersion: 7400
	Creator: "rusty test fixture"
}
Objects:  {
	Geometry: 1000, "Geometry::Tri", "Mesh" {
		Vertices: *9 {
			a: 0,0,0,1,0,0,0,1,0
		}
		PolygonVertexIndex: *3 {
			a: 0,1,-3
		}
		GeometryVersion: 124
	}
	Model: 2000, "Model::Tri", "Mesh" {
		Version: 232
	}
	Material: 3000, "Material::Physical", "" {
		Version: 102
		ShadingModel: "unknown"
		Properties70:  {
			P: "3dsMax|ClassIDa", "int", "Integer", "",1030429932
			P: "3dsMax|ClassIDb", "int", "Integer", "",-559038463
			P: "3dsMax|Parameters|base_weight", "Float", "", "A",0.8
			P: "3dsMax|Parameters|base_color", "ColorAndAlpha", "", "A",0.5,0.25,1,1
		}
	}
}
Connections:  {
	C: "OO",2000,0
	C: "OO",1000,2000
	C: "OO",3000,2000
}
